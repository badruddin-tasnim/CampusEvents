flowchart TB
    subgraph UI_Layer ["Presentation Layer (React + Tailwind CSS)"]
        Nav["Navigation & Header"]
        M1_UI["M1: Auth & Login Modal"]
        M2_UI["M2: Event Catalog & Search Bar"]
        M3_UI["M3: Admin Management Dashboard"]
        M4_UI["M4: RSVP & Ticket Booking View"]
        M5_UI["M5: Announcements & Feedback Tray"]
    end

    subgraph Design_Patterns ["Design Patterns Layer"]
        Singleton["Singleton Pattern:\nFirebaseConfigManager"]
        Factory["Factory Pattern:\nEventFactory"]
        Observer["Observer Pattern:\nEventBus (Pub-Sub)"]
    end

    subgraph Service_Layer ["Application & Domain Service Layer"]
        AuthService["AuthService\n(Google Sign-In & Fixed Admin)"]
        EventService["EventService\n(CRUD, RSVP, Quota Engine)"]
        FeedbackService["FeedbackService\n(Ratings & Announcements)"]
    end

    subgraph Persistence_Layer ["Data & Persistence Layer"]
        Firestore["Firebase Firestore (Cloud DB)"]
        LocalStorage["Local Storage Persistence Adapter\n(Offline Fallback Engine)"]
    end

    UI_Layer --> Service_Layer
    UI_Layer -.-> Observer
    Service_Layer --> Design_Patterns
    Service_Layer --> Persistence_Layer
    Design_Patterns --> Persistence_Layer
