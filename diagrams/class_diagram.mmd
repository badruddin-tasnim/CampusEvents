classDiagram
    direction TB

    %% Creational: Singleton Pattern
    class FirebaseConfigManager {
        <<Singleton>>
        -static instance: FirebaseConfigManager
        -auth: FirebaseAuth
        -db: Firestore
        -isLiveConfig: boolean
        -FirebaseConfigManager()
        +static getInstance(): FirebaseConfigManager
        +static resetInstance(): void
        +getAuth(): FirebaseAuth
        +getDb(): Firestore
        +isLive(): boolean
    }

    %% Creational: Factory Pattern
    class EventFactory {
        <<Factory>>
        +static createEvent(category: String, data: Object): CampusEvent
        +static getAvailableCategories(): List~String~
    }

    %% Core Entity: Abstract Base Class
    class CampusEvent {
        <<abstract>>
        #id: String
        #title: String
        #description: String
        #category: String
        #date: String
        #time: String
        #venue: String
        #capacity: int
        #registeredCount: int
        #organizer: String
        +hasAvailableSeats(): boolean
        +getAvailableSeats(): int
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    %% Specialized Event Subclasses (Inheritance / Generalization)
    class AcademicEvent {
        -speaker: String
        -prerequisites: String
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    class CulturalEvent {
        -performers: List~String~
        -dressCode: String
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    class SportsEvent {
        -teamSize: int
        -tournamentType: String
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    class WorkshopEvent {
        -materialsRequired: List~String~
        -certificateProvided: boolean
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    %% Behavioral: Observer Pattern
    class EventBus {
        <<Observer - Subject>>
        -static instance: EventBus
        -listeners: Map~String, List~Function~~
        -EventBus()
        +static getInstance(): EventBus
        +subscribe(topic: String, callback: Function): Function
        +publish(topic: String, payload: Object): void
        +clear(): void
    }

    %% Entities
    class RSVPReservation {
        +id: String
        +eventId: String
        +userId: String
        +userName: String
        +userEmail: String
        +ticketCode: String
        +bookedAt: String
        +status: String
        +isValid(): boolean
    }

    class UserProfile {
        +uid: String
        +email: String
        +displayName: String
        +role: String
        +photoURL: String
        +isAdmin(): boolean
    }

    %% Domain Service Layer
    class EventService {
        -firebase: FirebaseConfigManager
        +getAllEvents(): List~CampusEvent~
        +getEventById(id: String): CampusEvent
        +createEvent(data: Object): CampusEvent
        +updateEvent(id: String, data: Object): CampusEvent
        +deleteEvent(id: String): boolean
        +reserveSpot(eventId: String, user: UserProfile): RSVPReservation
        +cancelReservation(id: String, user: UserProfile): boolean
        +getUserReservations(userId: String): List~RSVPReservation~
    }

    class AuthService {
        -firebase: FirebaseConfigManager
        -currentUser: UserProfile
        +loginWithGoogle(): UserProfile
        +loginAsAdmin(email: String, pass: String): UserProfile
        +logout(): void
        +getCurrentUser(): UserProfile
        +isAdmin(): boolean
    }

    %% Inheritance Hierarchies (Generalization)
    CampusEvent <|-- AcademicEvent
    CampusEvent <|-- CulturalEvent
    CampusEvent <|-- SportsEvent
    CampusEvent <|-- WorkshopEvent

    %% Composition: CampusEvent strongly owns its reservations
    CampusEvent "1" *-- "0..*" RSVPReservation : "contains"

    %% Aggregation: UserProfile has reservations (weak ownership)
    UserProfile "1" o-- "0..*" RSVPReservation : "holds"

    %% Service Associations & Dependencies
    EventService "1" o-- "0..*" CampusEvent : "manages"
    EventService ..> EventFactory : "uses (creates events)"
    EventService ..> EventBus : "publishes state changes"
    EventService ..> FirebaseConfigManager : "accesses db"
    AuthService ..> FirebaseConfigManager : "accesses auth"
    AuthService "1" o-- "0..1" UserProfile : "maintains session"
