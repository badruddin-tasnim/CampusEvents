classDiagram
    direction TB

    class EventFactory {
        <<Creator / Factory>>
        +static createEvent(category: String, data: Object): CampusEvent
        +static getAvailableCategories(): List~String~
    }

    class CampusEvent {
        <<Abstract Product>>
        +id: String
        +title: String
        +description: String
        +category: String
        +date: String
        +time: String
        +venue: String
        +capacity: int
        +registeredCount: int
        +organizer: String
        +hasAvailableSeats(): boolean
        +getAvailableSeats(): int
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    class AcademicEvent {
        <<Concrete Product>>
        +speaker: String
        +prerequisites: String
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    class CulturalEvent {
        <<Concrete Product>>
        +performers: List~String~
        +dressCode: String
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    class SportsEvent {
        <<Concrete Product>>
        +teamSize: int
        +tournamentType: String
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    class WorkshopEvent {
        <<Concrete Product>>
        +materialsRequired: List~String~
        +certificateProvided: boolean
        +getBadgeColor(): String
        +validate(): ValidationResult
    }

    class Client_EventService {
        +createEvent(data: Object): CampusEvent
        +updateEvent(id: String, data: Object): CampusEvent
    }

    Client_EventService ..> EventFactory : "requests creation"
    EventFactory ..> CampusEvent : "creates (Factory Method)"
    CampusEvent <|-- AcademicEvent : "Inheritance (is-a)"
    CampusEvent <|-- CulturalEvent : "Inheritance (is-a)"
    CampusEvent <|-- SportsEvent : "Inheritance (is-a)"
    CampusEvent <|-- WorkshopEvent : "Inheritance (is-a)"
